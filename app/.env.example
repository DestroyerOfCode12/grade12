# MatricQuest SA — mobile app build-time configuration.
#
# These are NOT read by `flutter run` automatically — Flutter has no built-in .env loader by
# design (secrets must never ship in the compiled bundle as plain strings any more than
# necessary). This file documents the values; pass them at build/run time with --dart-define,
# e.g.:
#
#   flutter run \
#     --dart-define=SUPABASE_URL=https://xxxx.supabase.co \
#     --dart-define=SUPABASE_ANON_KEY=eyJ...
#
# Or put them in a git-ignored dart-define JSON file and pass --dart-define-from-file=env.json
# (supported by Flutter 3.x+). NEVER commit a filled-in copy of this file or an env.json with
# real values — .gitignore already excludes env.json and *.local.json.
#
# Leaving these empty runs the app in local dev mode (see lib/core/config/env.dart): seeded demo
# content, guest-only auth, no network calls to Supabase or the AI provider.

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Only the ANON key belongs here. The service_role key and AI provider key are SERVER secrets —
# they live in Supabase Edge Function secrets (see supabase/functions/README.md), never in this
# file, never in --dart-define, never in the compiled app.
