# MatricQuest SA — Supabase server-side secrets.
# Set these with `supabase secrets set --env-file supabase/.env.local` (gitignored), never commit
# a filled-in copy. The Edge Functions read these via Deno.env — see supabase/functions/_shared.

# Provided automatically by the Supabase platform inside Edge Functions; listed here only for
# local `supabase functions serve` testing.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider key for Quest Coach (supabase/functions/quest-coach). Absent = LocalStubProvider,
# zero external calls, zero cost — see supabase/functions/_shared/ai_provider.ts.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Push notifications (FCM server key / APNs credentials) — used by a future notifications
# Edge Function (CONTINUATION.md Phase 4/6 item), not yet implemented.
FCM_SERVER_KEY=
