# MatricQuest SA Admin — build-time configuration.
#
# Unlike the mobile app, there is no local-dev-mode fallback here — this dashboard edits real
# backend data, so it needs a real Supabase project to be useful at all. Build/run with:
#
#   flutter run -d chrome \
#     --dart-define=SUPABASE_URL=https://xxxx.supabase.co \
#     --dart-define=SUPABASE_ANON_KEY=eyJ...
#
# Never commit a filled-in copy of this file. The signed-in user must have `profiles.role` set to
# 'content_reviewer', 'admin', or 'super_admin' (see supabase/migrations/0013 and AuthGate) —
# create that account and role through Supabase Auth + a direct SQL update (or
# `admin_set_user_role` once at least one admin exists) before first sign-in.

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Uploading past-paper files (Papers screen) needs a Storage bucket named "papers" (private,
# signed-URL access) created in the Supabase dashboard first — see docs/SETUP.md.
